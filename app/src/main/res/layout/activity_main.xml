<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/dispositivo_indigo_redondeado_ancho">

    <LinearLayout
        android:id="@+id/layoutPrincipal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="70dp"
        android:paddingEnd="70dp"
        android:paddingTop="170dp"
        android:paddingBottom="40dp"
        android:gravity="center_horizontal">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <EditText
                android:id="@+id/textoEditableNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="Nombre del pokemon"
                android:inputType="text"
                android:minHeight="48dp" />

            <EditText
                android:id="@+id/textoEditableHabilidad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="Habilidad (ej. Impactrueno)"
                android:inputType="text"
                android:minHeight="48dp" />

            <Spinner
                android:id="@+id/listaTipos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:entries="@array/tipos"
                android:spinnerMode="dropdown" />

            <Button
                android:id="@+id/botonPokedex"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Ver Pokédex" />

            <Button
                android:id="@+id/botonHistorial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Historial Pokédex" />

            <Button
                android:id="@+id/botonExplorarPokedex"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Explorar Pokedex" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>