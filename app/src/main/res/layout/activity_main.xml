<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutPrincipal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="70dp"
    android:paddingEnd="70dp"
    android:paddingTop="195dp"
    android:paddingBottom="250dp"
    android:background="@drawable/dispositivo_indigo_redondeado_ancho" >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <EditText
            android:id="@+id/textoEditableNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Nombre del pokemon"
            android:inputType="text"
            android:minHeight="48dp" />

        <Spinner
            android:id="@+id/listaTipos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:entries="@array/tipos"
            android:spinnerMode="dropdown"
            android:dropDownHeight="15dp" />

        <Button
            android:id="@+id/botonPokedex"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Ver Pokédex" />

        <Button
            android:id="@+id/botonHistorial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Historial Pokédex" />

    </LinearLayout>

</LinearLayout>