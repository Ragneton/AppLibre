<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <TextView
            android:id="@+id/textoNumero"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="N.º 000"
            android:textSize="18sp" />

        <ImageView
            android:id="@+id/imagenDetalle"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:contentDescription="Imagen del Pokémon"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/textoNombre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nombre"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textoTipos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Tipos"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/textoHabilidades"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Habilidades"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/textoAltura"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Altura"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/textoPeso"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Peso"
            android:textSize="18sp" />

        <ProgressBar
            android:id="@+id/progresoDetalle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/textoErrorDetalle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="No se ha podido cargar el Pokémon."
            android:visibility="gone" />

        <Button
            android:id="@+id/botonFavorito"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="☆ Añadir a favoritos"
            android:visibility="gone" />

        <Button
            android:id="@+id/botonVolverDetalle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Volver" />

    </LinearLayout>

</ScrollView>
